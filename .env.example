# ============================================================
# Portfolio Landing Page + CMS — Environment Variables
# ============================================================
# Copy this file to `.env.local` and fill in real values.
# See `.agent/architecture/env/instruction.md` for step-by-step
# instructions on how to obtain every credential below.
#
# `.env.example` is committed to the repo (safe — placeholders only).
# `.env.local` must NEVER be committed. It is already gitignored.
# ============================================================

# ---------- Database (Neon — serverless Postgres) ----------
# Pooled connection string from the Neon console:
#   https://console.neon.tech → your project → Connect → Connection string
# Use the POOLED connection (serverless driver) for Next.js on Vercel.
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ---------- Session (iron-session, admin auth) ----------
# 32+ random characters. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# ---------- Cloudflare R2 (media storage) ----------
# Account ID — Cloudflare dashboard, right-hand sidebar of the overview page
R2_ACCOUNT_ID=
# Access Key ID from an R2 API token with "Object Read & Write" permission,
# scoped to the media bucket only
R2_ACCESS_KEY_ID=
# Secret Access Key from the same R2 API token (shown only once at creation)
R2_SECRET_ACCESS_KEY=
# The bucket created in R2 
R2_BUCKET_NAME=zue-creatives-landingpage
# Public custom domain connected to the bucket, e.g. https://media.yourdomain.com
# Do NOT use the default r2.dev URL in production — set up a custom domain
R2_PUBLIC_MEDIA_URL=https://media.yourdomain.com

# ---------- App ----------
# Production site URL, no trailing slash
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# Client's WhatsApp number in E.164 format — no "+", no spaces, country code first.
# Example: 2348012345678 (Nigeria)
WHATSAPP_PHONE_NUMBER=
# The client's existing Google Form (enquiry flow). Paste the full shareable
# form link here when available.
NEXT_PUBLIC_GOOGLE_FORM_URL=
# Custom WhatsApp URL (e.g. https://wa.me/2348012345678 or a deep link).
NEXT_PUBLIC_WHATSAPP_URL=